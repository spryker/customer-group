{% extends '@Gui/Layout/layout.twig' %}

{% set widget_title = 'View customer group' %}

{% block head_title widget_title | trans %}
{% block section_title widget_title | trans %}

{% block action %}
    {{ backActionButton('/customer-group', 'List Customer Groups' | trans) }}
    {{ editActionButton('/customer-group/edit?id-customer-group=' ~ idCustomerGroup, 'Edit Customer Group' | trans) }}
{% endblock %}

{% block content %}

    {% if blocks is defined %}
        {% for blockName, block in blocks %}
            <div data-qa="customer-group-view-block-{{ blockName }}">
                {{ include(block.templatePath, block.templateData) }}
            </div>
        {% endfor %}
    {% else %}
        {{ include('@CustomerGroup/View/_partials/general-information.twig') }}
        {{ include('@CustomerGroup/View/_partials/customers.twig') }}
    {% endif %}

{% endblock %}
